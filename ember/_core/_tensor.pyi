from numpy.typing import NDArray

class _Tensor:
    def __init__(self, size: int) -> None: ...
    @property
    def _size(self) -> int: ...
    def _copy_from_list(self, data: list[float]) -> None: ...
    def _to_list(self, shape: tuple[int, ...]) -> list[float] | list[list[float]]: ...
    def _to_np(self) -> NDArray: ...

# tensor operators
def _add_tensor(a: _Tensor, b: _Tensor) -> _Tensor: ...
def _sub_tensor(a: _Tensor, b: _Tensor) -> _Tensor: ...
def _mul_tensor(a: _Tensor, b: _Tensor) -> _Tensor: ...
def _truediv_tensor(a: _Tensor, b: _Tensor) -> _Tensor: ...
def _max_tensor(a: _Tensor, b: _Tensor) -> _Tensor: ...
def _min_tensor(a: _Tensor, b: _Tensor) -> _Tensor: ...
def _gt_tensor(a: _Tensor, b: _Tensor) -> _Tensor: ...
def _lt_tensor(a: _Tensor, b: _Tensor) -> _Tensor: ...
def _pow_tensor(a: _Tensor, b: _Tensor) -> _Tensor: ...

# fused activations: forward (unary), backward (binary over grad, y)
def _relu(a: _Tensor) -> _Tensor: ...
def _sigmoid(a: _Tensor) -> _Tensor: ...
def _gelu(a: _Tensor) -> _Tensor: ...
def _relu_bwd_tensor(grad: _Tensor, y: _Tensor) -> _Tensor: ...
def _sigmoid_bwd_tensor(grad: _Tensor, y: _Tensor) -> _Tensor: ...
def _tanh_bwd_tensor(grad: _Tensor, y: _Tensor) -> _Tensor: ...
def _gelu_bwd(grad: _Tensor, x: _Tensor, y: _Tensor) -> _Tensor: ...

# scalar operators
def _add_scalar(a: _Tensor, b: float) -> _Tensor: ...
def _sub_scalar(a: _Tensor, b: float) -> _Tensor: ...
def _rsub_scalar(a: _Tensor, b: float) -> _Tensor: ...
def _mul_scalar(a: _Tensor, b: float) -> _Tensor: ...
def _truediv_scalar(a: _Tensor, b: float) -> _Tensor: ...
def _rtruediv_scalar(a: _Tensor, b: float) -> _Tensor: ...
def _max_scalar(a: _Tensor, b: float) -> _Tensor: ...
def _min_scalar(a: _Tensor, b: float) -> _Tensor: ...
def _gt_scalar(a: _Tensor, b: float) -> _Tensor: ...
def _lt_scalar(a: _Tensor, b: float) -> _Tensor: ...
def _pow_scalar(a: _Tensor, b: float) -> _Tensor: ...
def _rpow_scalar(a: _Tensor, b: float) -> _Tensor: ...

# broadcasted operators
def _add_broadcasted(
    a: _Tensor,
    b: _Tensor,
    out_shape: tuple[int, ...],
    strides_a: tuple[int, ...],
    strides_b: tuple[int, ...],
) -> _Tensor: ...
def _sub_broadcasted(
    a: _Tensor,
    b: _Tensor,
    out_shape: tuple[int, ...],
    strides_a: tuple[int, ...],
    strides_b: tuple[int, ...],
) -> _Tensor: ...
def _mul_broadcasted(
    a: _Tensor,
    b: _Tensor,
    out_shape: tuple[int, ...],
    strides_a: tuple[int, ...],
    strides_b: tuple[int, ...],
) -> _Tensor: ...
def _truediv_broadcasted(
    a: _Tensor,
    b: _Tensor,
    out_shape: tuple[int, ...],
    strides_a: tuple[int, ...],
    strides_b: tuple[int, ...],
) -> _Tensor: ...

# unary operators
def _negate(a: _Tensor) -> _Tensor: ...
def _exponent(a: _Tensor) -> _Tensor: ...
def _log(a: _Tensor) -> _Tensor: ...
def _sqrt(a: _Tensor) -> _Tensor: ...

# unary trig operators
def _sin(a: _Tensor) -> _Tensor: ...
def _cos(a: _Tensor) -> _Tensor: ...
def _tan(a: _Tensor) -> _Tensor: ...
def _ctg(a: _Tensor) -> _Tensor: ...

# unary trig hyperbolic operators
def _sinh(a: _Tensor) -> _Tensor: ...
def _cosh(a: _Tensor) -> _Tensor: ...
def _tanh(a: _Tensor) -> _Tensor: ...
def _ctgh(a: _Tensor) -> _Tensor: ...

# in-place operators (mutate `a`, return None)
def _iadd(a: _Tensor, b: _Tensor) -> None: ...
def _isub(a: _Tensor, b: _Tensor) -> None: ...
def _imul(a: _Tensor, b: _Tensor) -> None: ...
def _itruediv(a: _Tensor, b: _Tensor) -> None: ...
def _iadd_scalar(a: _Tensor, b: float) -> None: ...
def _isub_scalar(a: _Tensor, b: float) -> None: ...
def _imul_scalar(a: _Tensor, b: float) -> None: ...
def _itruediv_scalar(a: _Tensor, b: float) -> None: ...

# transpose
def _transpose(a: _Tensor, n: int, m: int) -> _Tensor: ...

# misc operators
def _matmul(a: _Tensor, b: _Tensor, n: int, m: int, k: int) -> _Tensor: ...
def _matmul_bias(
    a: _Tensor, b: _Tensor, bias: _Tensor, n: int, m: int, k: int
) -> _Tensor: ...
def _matmul_batched(
    a: _Tensor, b: _Tensor, batch: int, n: int, m: int, k: int
) -> _Tensor: ...
def _from_numpy(a: NDArray) -> _Tensor: ...
def _sum(a: _Tensor) -> float: ...
def _sum_axis(a: _Tensor, shape: tuple[int, ...], axis: int) -> _Tensor: ...
def _max_axis(a: _Tensor, shape: tuple[int, ...], axis: int) -> _Tensor: ...

# fused optimizer steps (mutate p, m, v in place)
def _adam_step(
    p: _Tensor,
    g: _Tensor,
    m: _Tensor,
    v: _Tensor,
    lr: float,
    beta1: float,
    mb1: float,
    beta2: float,
    mb2: float,
    eps: float,
    bc1: float,
    bc2: float,
) -> None: ...
def _adamw_step(
    p: _Tensor,
    g: _Tensor,
    m: _Tensor,
    v: _Tensor,
    lr: float,
    beta1: float,
    mb1: float,
    beta2: float,
    mb2: float,
    eps: float,
    bc1: float,
    bc2: float,
    weight_decay: float,
) -> None: ...
def _sgd_step(
    p: _Tensor, g: _Tensor, v: _Tensor, lr: float, momentum: float
) -> None: ...

# device / CUDA-graph control
def _sync() -> None: ...
def _empty_cache() -> None: ...
def _begin_capture() -> None: ...
def _end_capture() -> int: ...
def _graph_launch(handle: int) -> None: ...
def _graph_destroy(handle: int) -> None: ...
